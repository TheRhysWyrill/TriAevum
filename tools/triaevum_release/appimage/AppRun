#!/bin/sh
set -eu
# Keep Steam Input, Gamescope and display selection in the inherited environment.
APPDIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export APPDIR
package="$APPDIR/usr/lib/triaevum"
# Portable storage: a writable AppImage location keeps the writable root in a
# TriAevum folder beside the file, because the shared root is XDG_DATA_HOME's
# TriAevum folder. Read-only media keeps the per-user default instead of
# failing every write. host_layout makes the same choice from the payload.
if [ -n "${APPIMAGE:-}" ] && [ -d "$(dirname -- "$APPIMAGE")" ] &&
   [ -w "$(dirname -- "$APPIMAGE")" ]; then
    XDG_DATA_HOME="$(CDPATH= cd -- "$(dirname -- "$APPIMAGE")" && pwd)"
    export XDG_DATA_HOME
fi
export LD_LIBRARY_PATH="$package/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# lib/compat-cxx carries the SDK's libstdc++/libgcc_s. Use it only when the
# host's libstdc++ is missing or older: one copy serves the whole process,
# and the host GPU driver may need the newer host library.
glibcxx_level() {
    grep -ao 'GLIBCXX_3\.4\.[0-9]*' "$1" 2>/dev/null | sed 's/.*\.//' | sort -n | tail -n 1
}
compat="$package/lib/compat-cxx"
if [ -r "$compat/libstdc++.so.6" ]; then
    bundled="$(glibcxx_level "$compat/libstdc++.so.6")"
    host="$( (/sbin/ldconfig -p || ldconfig -p) 2>/dev/null |
        sed -n 's/^[[:space:]]*libstdc++\.so\.6 (libc6,x86-64[^)]*) => //p' | head -n 1)"
    level=""
    [ -n "$host" ] && [ -r "$host" ] && level="$(glibcxx_level "$host")"
    if [ -z "$level" ] || [ "${bundled:-0}" -gt "$level" ]; then
        export LD_LIBRARY_PATH="$compat:$LD_LIBRARY_PATH"
    fi
fi
# A launch that cannot reach the Forge must say so: a desktop launch that exits
# silently is indistinguishable from "the application does nothing".
if [ ! -x "$package/TriAevumForge" ]; then
    echo "TriAevum: bundled Forge is missing or not executable: $package/TriAevumForge" >&2
    exit 1
fi
exec "$package/TriAevumForge" --play "$@"
